# Скопируй в .env (рядом с bot_gelbooru.py) и впиши значения.
# .env в git НЕ попадает.

# Токен бота из Discord Developer Portal (ОБЯЗАТЕЛЬНО)
DISCORD_BOT_TOKEN=

# Ключи Gelbooru (ОБЯЗАТЕЛЬНО для /gelbooru — без них Gelbooru отвечает 401).
# Берутся на gelbooru.com → My Account → Options → API Access Credentials.
GELBOORU_API_KEY=
GELBOORU_USER_ID=

# ID серверов через запятую — слэш-команды появятся мгновенно (опционально).
# Пусто → глобальная регистрация (до часа).
DISCORD_GUILD_IDS=

# Для /tg (Telegram-userbot через Telethon). Без них /tg отключается.
# Строку сессии даёт: python tg_export_session.py
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=

# Опционально:
# GELBOORU_PROXY=http://user:pass@host:port   # если сайты заблокированы
# MAX_UPLOAD_MB=10                             # потолок размера файла
# DATA_DIR=/data                               # постоянный диск для shown.sqlite3 и индексов

# SEARCH_TIMEOUT_SECONDS=20                    # бюджет поиска; рабочий потолок 30 сек
